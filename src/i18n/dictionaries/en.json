"signIn\": \"Sign in\"\n  },\n  \"marketPage\": {\n    \"metaTitle\": \"Riyadh commercial market pulse | SAT Markets\",\n    \"metaDesc\": \"The Riyadh commercial market at a glance: published, attributed Rent Index bands and indicators computed from platform records. Indicative, not advice.\",\n    \"home\": \"Home\",\n    \"eyebrow\": \"Market pulse\",\n    \"h1\": \"The Riyadh commercial market, at a glance\",\n    \"intro\": \"Every figure on this page comes from platform records or the Rent Index, derived from the REGA Rental Index (Ejar), on the platform sample. No estimates, no unsourced numbers.\",\n    \"kpiSpaces\": \"spaces live\",\n    \"kpiLocations\": \"locations covered\",\n    \"kpiSegments\": \"index segments with sufficient data\",\n    \"kpiNa\": \"n/a\",\n    \"kpiMedianOffice\": \"Office rent, median across cells\",\n    \"bandsTitle\": \"Office rent bands by location\",\n    \"bandsUnit\": \" · SAR/m²/yr\",\n    \"bandsCaption\": \"The bar is the index band, the dot is the average. Sufficient segments only.\",\n    \"supplyTitle\": \"Supply by asset type\",\n    \"dealsLabel\": \"Deals:\",\n    \"pricingTitle\": \"Pricing discipline\",\n    \"pricingNote\": \"The index grades prices, never people. Indicative, not advice.\",\n    \"ctaBrowse\": \"Browse the spaces\",\n    \"ctaIndex\": \"The full Rent Index\",\n    \"ctaLocations\": \"Locations directory\",\n    \"sampleNote\": \"Pre-launch sample data illustrating the mechanism. Attributed published benchmarks live on the Rent Index page.\",\n    \"quoteBelow\": \"Below their index band\",\n    \"quoteWithin\": \"Within their index band\",\n    \"quoteAbove\": \"Above their index band\",\n    \"quoteIntro\": \"Of {count} with a sufficient index segment, this is where asking rents sit against their band.\",\n    \"leaseSaleSplit\": \"{lease} lease · {sale} sale\",\n    \"datasetName\": \"Riyadh Commercial Market Pulse\",\n    \"datasetDesc\": \"Commercial rent indicators for Riyadh derived from the REGA Rental Index (Ejar), compiled by SAT Markets. Figures are averages of registered rental contracts. Indicative market context, not advice.\",\n    \"datasetSource\": \"REGA Rental Index (Ejar), registered rental contracts\",\n    \"datasetCoverage\": \"Riyadh, Saudi Arabia\"\n  },\n  \"flyer\": {\n    \"riyadh\": \"Riyadh\",\n    \"backToListing\": \"Back to listing\",\n    \"printSave\": \"Print / save PDF\",\n    \"propertyFlyer\": \"Property flyer\",\n    \"lease\": \"Lease\",\n    \"sale\": \"Sale\",\n    \"area\": \"Area\",\n    \"grade\": \"Grade\",\n    \"fitout\": \"Fit-out\",\n    \"askingRent\": \"Asking rent\",\n    \"askingPrice\": \"Asking price\",\n    \"onRequest\": \"On request\",\n    \"pricedInContext\": \"Priced in context\",\n    \"platformSample\": \"platform sample\",\n    \"footer\": \"SAT Markets · Powered by SAT Real Estate · FAL 1200025510\",\n    \"scanHint\": \"Scan to open the live listing\",\n    \"qrAria\": \"QR code to the live listing\",\n    \"officeAvg\": \"Office rent, average across cells: {rate}\",\n    \"indexSource\": \"Source: REGA Rental Index (Ejar), average of registered rental contracts. Indicative, not advice.\",\n    \"metaTitle\": \"{title}, flyer | SAT Markets\",\n    \"metaDesc\": \"A printable one page summary of a listing on SAT Markets: its asking terms, its verification state and its Rent Index context.\",\n    \"metaTitleFallback\": \"{type} in {place}, flyer | SAT Markets\"\n  },\n  \"termsheet\": {\n    \"dealRoomLink\": \"← Deal room\",\n    \"printSave\": \"Print / save PDF\",\n    \"termSheetRef\": \"Term sheet · SR-20418\",\n    \"propertyTitle\": \"Grade A Office, sample building\",\n    \"propertySub\": \"320 m² · Al Olaya, Riyadh\",\n    \"parties\": \"Parties\",\n    \"whatNext\": \"What happens next\"\n  },\n  \"login\": {\n    \"eyebrow\": \"Sign in to SAT Markets\",\n    \"heading\": \"Welcome back\",\n    \"sub\": \"Sign in with your email and password. Occupiers can browse and enquire without an account.\",\n    \"emailPh\": \"you@company.com\",\n    \"passwordPh\": \"Password\",\n    \"signIn\": \"Sign in\",\n    \"signingIn\": \"Signing in…\",\n    \"or\": \"or\",\n    \"magicLink\": \"Email me a secure sign-in link\",\n    \"nafathNote\": \"Nafath national-ID sign-in for owners and brokers arrives before launch.\",\n    \"createAccount\": \"Create an account\",\n    \"checkEmail\": \"Check your email\",\n    \"checkEmailBody\": \"We sent a secure sign-in link to\",\n    \"yourInbox\": \"your inbox\",\n    \"backToSignIn\": \"Back to sign in\",\n    \"errNotConfigured\": \"Sign-in is not configured on this environment yet.\",\n    \"errEnterEmail\": \"Enter your email first, then request a link.\",\n    \"errSignIn\": \"We could not sign you in. Check your email address and password, or ask for a sign-in link below.\",\n    \"errLinkNotSent\": \"We could not send a sign-in link just now. Try again in a moment.\",\n    \"errProvider\": \"That sign-in could not be completed. Try again, or use your email address.\",\n    \"errLinkInvalid\": \"That sign-in link is invalid or has expired. Request a new one.\",\n    \"signOut\": \"Sign out\",\n    \"metaTitle\": \"Sign in | SAT Markets\",\n    \"metaDesc\": \"Sign in to SAT Markets to manage listings, enquiries and viewings.\"\n  },\n  \"reqDetail\": {\n    \"back\": \"All requirements\",\n    \"loading\": \"Loading requirement\",\n    \"notFound\": \"Requirement not found.\",\n    \"backLink\": \"Back to all requirements\",\n    \"lease\": \"Lease\",\n    \"buy\": \"Buy\",\n    \"size\": \"Size\",\n    \"budget\": \"Budget\",\n    \"timeline\": \"Timeline\",\n    \"na\": \"n/a\",\n    \"interestedH\": \"Who is interested\",\n    \"haveSpace\": \"I have space for this\",\n    \"interestedP\": \"Owners and brokers who can fill this requirement appear here. The occupier chooses who to talk to.\",\n    \"appearAs\": \"You appear as your account. Only owners and brokers on SAT Markets can register interest.\",\n    \"placeholder\": \"What you have that matches (size, district, fit-out)\",\n    \"msgLabel\": \"Your message to the occupier\",\n    \"matchesErr\": \"Your listings could not be checked. Close this panel and open it again to retry.\",\n    \"signIn\": \"Sign in\",\n    \"cancel\": \"Cancel\",\n    \"registering\": \"Registering\",\n    \"register\": \"Register interest\",\n    \"errRegister\": \"Could not register interest.\",\n    \"errSignIn\": \"Sign in to register interest.\",\n    \"none\": \"No interest yet. Responses will appear here.\",\n    \"aBroker\": \"A SAT broker\",\n    \"anOwner\": \"An owner\",\n    \"broker\": \"Broker\",\n    \"owner\": \"Owner\",\n    \"replyNote\": \"Replying inside SAT Markets is not built yet, and no contact details are shown on this page, so what each party wrote below is the whole of their response.\",\n    \"figureUnstated\": \"Not stated\",\n    \"interestedCount\": \"parties interested\",\n    \"interestedOne\": \"party interested\",\n    \"hiddenNote\": \"Respondent details are visible to the occupier who posted this requirement. They are not shown publicly.\",\n    \"ownersB\": \"owners\",\n    \"brokersB\": \"brokers\",\n    \"yours\": \"Your response\",\n    \"metaTitle\": \"Requirement | SAT Markets\",\n    \"metaDesc\": \"An occupier requirement published on SAT Markets. Owners and licensed brokers can register interest directly, with no assumed commission.\",\n    \"metaTitleEntity\": \"{title} | SAT Markets\",\n    \"matchesH\": \"Your listings against this requirement\",\n    \"matchesP\": \"Checked against the facts each record states. A fact neither record states is shown as an open question, never as a pass.\",\n    \"matchesLoading\": \"Checking your listings\",\n    \"matchesNone\": \"None of your published listings answer this requirement.\",\n    \"matchesWhy\": \"Why this result\",\n    \"matchesRemedy\": \"What would settle it\",\n    \"matchesAttach\": \"Attach this listing to your response\",\n    \"matchesAttached\": \"Attached to your response\",\n    \"matchesAttachNone\": \"Do not attach a listing to this response\",\n    \"matchesExcluded\": \"listings of yours are not offerable yet, so they were not compared. Drafts and expired advertising licences are never matched.\",\n    \"matchesMargins\": \"Published margins: size {size} percent, budget {budget} percent.\",\n    \"matchesTruncated\": \"Showing the closest results only.\",\n    \"timelineUnstated\": \"No date given\",\n    \"detailReady\": \"Requirement loaded\",\n    \"responseSaved\": \"Your response was registered. It appears in the list below.\"\n  },\n  \"locFacts\": {\n    \"title\": \"Location facts\",\n    \"computed\": \"Computed\",\n    \"km\": \"km\",\n    \"walk\": \"min walk\",\n    \"metro\": \"Nearest metro\",\n    \"airport\": \"Nearest airport\",\n    \"driveMin\": \"min\",\n    \"driving\": \"driving, typical off-peak\",\n    \"straightLine\": \"straight-line distance\",\n    \"exact\": \"Exact building location, shown on the map.\",\n    \"district\": \"District-level location. The exact address is shared on enquiry, so the marker shows the area, not the building.\",\n    \"less\": \"Less relevant for your use\",\n    \"lessMetro\": \"Metro proximity has little bearing on a logistics or storage site.\",\n    \"lessAirport\": \"Airport distance has little bearing on a neighbourhood retail unit.\",\n    \"mapAria\": \"Map showing the listing location\",\n    \"mapUnavailable\": \"Map unavailable\",\n    \"loadingMap\": \"Loading map\",\n    \"sourceLine\": \"Metro: Riyadh Metro network, RCRC Open Data. Distances computed by SAT Markets.\",\n    \"rail\": \"Nearest high-speed rail\",\n    \"lessRail\": \"High-speed rail proximity has little bearing on a logistics or storage site.\",\n    \"thisSpace\": \"This space\",\n    \"metroDot\": \"Metro station\",\n    \"srcMetro\": \"Metro: Riyadh Metro network, RCRC Open Data.\",\n    \"srcRail\": \"High-speed rail: Haramain stations, OpenStreetMap.\",\n    \"srcComputed\": \"Distances computed by SAT Markets.\",\n    \"srcTravel\": \"Travel time via\"\n  },\n  \"listerPage\": {\n    \"metaTitle\": \"{name} | SAT Markets\",\n    \"metaDesc\": \"Commercial spaces listed by {name} on SAT Markets, with published Rent Index context where available.\",\n    \"metaTitleFallback\": \"Lister | SAT Markets\",\n    \"metaDescFallback\": \"Owners and licensed brokers listing commercial space on SAT Markets.\",\n    \"roleBroker\": \"Licensed broker\",\n    \"roleOwner\": \"Owner\",\n    \"spaces\": \"Spaces on the market\",\n    \"none\": \"No spaces are live right now.\",\n    \"website\": \"Website\",\n    \"onReq\": \"On request\",\n    \"forLease\": \"for lease\",\n    \"forSale\": \"for sale\",\n    \"since\": \"On SAT Markets since\",\n    \"verifiedBy\": \"Identity verified by SAT\",\n    \"operator\": \"SAT Real Estate operates this exchange and lists as a licensed brokerage like any other lister, with no badge or placement another lister cannot earn.\",\n    \"metaDescVerified\": \"Commercial spaces listed by {name}, whose identity is verified by SAT Markets, with published Rent Index context where available.\"\n  },\n  \"legalMeta\": {\n    \"termsTitle\": \"Terms of Service | SAT Markets\",\n    \"termsDesc\": \"The terms that govern access to and use of the SAT Markets exchange, its Rent Index and its advisor. A working draft pending review by licensed counsel in Saudi Arabia.\",\n    \"privacyTitle\": \"Privacy Policy | SAT Markets\",\n    \"privacyDesc\": \"How SAT Markets collects, uses and protects personal data, and the choices open to you. A working draft pending review by licensed counsel in Saudi Arabia.\",\n    \"contactTitle\": \"Contact | SAT Markets\",\n    \"contactDesc\": \"Reach SAT Real Estate about a listing, the Rent Index or a partnership. Riyadh, Saudi Arabia. REGA FAL licence 1200025510.\"\n  },\n  \"appMeta\": {\n    \"title\": \"SAT Markets | Commercial real estate, Saudi Arabia\",\n    \"description\": \"Riyadh-first commercial leasing and sales exchange. Commercial spaces listed by owners and licensed brokers, a source-attributed rent index, and AI search. A neutral commercial real estate intelligence platform.\",\n    \"appName\": \"SAT Markets\"\n  },\n  \"notFound\": {\n    \"body\": \"This page could not be found.\",\n    \"back\": \"Back to SAT Markets\"\n  },\n  \"errorPage\": {\n    \"body\": \"We could not load this page. Try again.\",\n    \"retry\": \"Try again\"\n  },\n  \"neutrality\": {\n    \"eyebrow\": \"Neutrality\",\n    \"title\": \"How SAT Markets stays neutral\",\n    \"intro\": \"We disclose this plainly: SAT Markets is operated by SAT Real Estate, a licensed real estate company (FAL 1200025510), and SAT Real Estate also has a licensed brokerage arm. We run the exchange so that operating it gives SAT no advantage as a broker. Neutrality here is not a slogan; it is a set of commitments you can check.\",\n    \"commitmentsTitle\": \"The neutrality commitments\",\n    \"whyTitle\": \"Why one entity, for now\",\n    \"whyBody\": \"During this preview the platform operates under SAT Real Estate's licence, and the separation between SAT-as-operator and SAT-as-broker is contractual and operational. We are considering a separate legal entity for the exchange before public launch. We would rather be candid about this arrangement than hide it.\",\n    \"closeTitle\": \"If you ever see neutrality break\",\n    \"closeBody\": \"If you ever see SAT-as-operator giving SAT-as-broker an edge, that is a bug to fix. Tell us via the contact page.\",\n    \"cta\": \"Contact us\",\n    \"cRankT\": \"No ranking preference\",\n    \"cRankB\": \"SAT Real Estate publishes its own listings here, as any licensed broker does. They are marked as ours, they sit in the same ranking, and they get no placement, badge or feature another broker cannot get.\",\n    \"cActT\": \"We do not act for anyone\",\n    \"cActB\": \"SAT Markets does not represent tenants, buyers, owners or brokers. There is one path off a listing and it goes to the lister. We removed the representation service entirely rather than run an exchange that competes with the people listing on it.\",\n    \"cDataT\": \"No data advantage\",\n    \"cDataB\": \"SAT's brokerage arm gets no earlier or privileged access to leads, requirements, or index data than any other verified participant.\",\n    \"cVerifT\": \"Verification is authority-decided\",\n    \"cVerifB\": \"A “verified” badge comes from an authoritative record match or a human reviewer, never from SAT choosing to favour itself.\",\n    \"cReportT\": \"We report on it\",\n    \"cReportB\": \"We intend to publish, each quarter, what share of listings and deals were SAT Real Estate's own, so the balance is visible to everyone and not merely asserted. (Planned.)\",\n    \"metaTitle\": \"How SAT Markets stays neutral | SAT Markets\",\n    \"metaDesc\": \"SAT Markets is operated by SAT Real Estate and discloses it openly. Here is exactly how operating the exchange gives SAT no advantage as a broker.\"\n  },\n  \"verification\": {\n    \"eyebrow\": \"Trust and legal\",\n    \"title\": \"What a verification means here\",\n    \"intro\": \"Verification is a word most platforms use without defining it. This page defines it, and every label below is generated by the same code that decides what a listing page shows, so the page cannot drift away from the rule it describes.\",\n    \"twoTitle\": \"Two different checks, never merged\",\n    \"twoBody\": \"Owner verification and listing verification answer different questions. A platform that reports one badge for both is telling you less than it appears to.\",\n    \"ownerT\": \"Owner verification\",\n    \"ownerB\": \"We checked the person and their ownership of this specific asset. It says nothing about whether the asset may lawfully be advertised.\",\n    \"listingT\": \"Listing verification\",\n    \"listingB\": \"The asset also carries a valid advertising permit and the right to market is confirmed. This is the stronger of the two, and it is the one that governs whether a listing may be marketed at all.\",\n    \"satT\": \"Filed by SAT\",\n    \"satB\": \"A listing filed by SAT Real Estate itself carries neither check by virtue of who filed it. Being our own listing is not evidence about the asset.\",\n    \"dimsTitle\": \"The dimensions a listing record can carry\",\n    \"dimsBody\": \"Each dimension is checked and reported on its own. A listing is never summarised into a single word, because the single word is where the two checks above get merged. Identity is a dimension too, but it belongs to the account rather than to the asset.\",\n    \"statesTitle\": \"The states a dimension can be in\",\n    \"statesBody\": \"There are five, and two of them are not failures. Not applicable means the check does not apply to this record. Not verified means we have not established it, which is different from having established that it is false.\",\n    \"unknownT\": \"An unknown never becomes a known\",\n    \"unknownB\": \"Where we hold nothing, the surface says so in those words rather than leaving a blank, because a blank is filled in by the reader and it is filled in optimistically.\",\n    \"collideT\": \"Two of the five print the same words on purpose\",\n    \"collideB\": \"not_verified and unknown carry the same badge text, so the table above shows one label twice. That is deliberate and it is the safer of the two mistakes: a dimension we have never looked at must never read better on a listing than one we looked at and could not confirm. The raw key beside each row is what the record actually holds, and it is the one that differs.\",\n    \"demoteTitle\": \"How a record is demoted\",\n    \"demoteBody\": \"The flag alone is never enough, because a flag is a claim rather than a check. Five conditions are read on every record and any one of them is sufficient on its own. The third is recorded as one of two reasons, depending on whether the record names a seeding method or names no method at all. Below are the six reasons in the words the code itself returns.\",\n    \"gateTitle\": \"Why a listing fails the marketing gate\",\n    \"gateBody\": \"These are the reasons the gate itself returns. They are the same strings a listing page prints, read from the gate rather than described.\",\n    \"todayTitle\": \"What the records actually hold today\",\n    \"todayBody\": \"Stated plainly, because the alternative is a page describing a system that is not the one running. Every one of the 88 published rows is a demonstration record. All of them carry an ownership flag and an authorisation flag. None carries an advertising permit number. Of the 88, 50 record a method of seed and 38 record no method at all, and not one names an accountable checker. Nine rows state a lister relationship that contradicts the filing account. Under the rule above, no published row here passes, and every listing surface says so rather than showing a badge.\",\n    \"noteTitle\": \"What this page is not\",\n    \"noteBody\": \"It is not a promise about future inventory and not a claim about the market. It states the rule and reports the current state of the records under it. When the records change, this page changes with them, because it reads them.\",\n    \"metaTitle\": \"What verification means | SAT Markets\",\n    \"metaDesc\": \"Owner verification and listing verification are different checks. The dimensions, the states, the four demotion conditions and the current state of the records, read from the code that enforces them.\"\n  },\n  \"sources\": {\n    \"eyebrow\": \"Trust and legal\",\n    \"title\": \"Where the data comes from, and what we may do with it\",\n    \"intro\": \"Every source on this platform carries a recorded policy: whether we may store it, show it again, show something derived from it, export it, let the assistant retrieve it, and send it to an external model. The table below is that register, read at request time. It is not a summary of the register.\",\n    \"countLabel\": \"Sources in the register\",\n    \"colSource\": \"Source\",\n    \"colStore\": \"Storage\",\n    \"colRedisplay\": \"Show again\",\n    \"colDerived\": \"Show derived\",\n    \"colExport\": \"Export\",\n    \"colAi\": \"Assistant retrieval\",\n    \"colStatus\": \"Rights status\",\n    \"pNone\": \"Not permitted\",\n    \"pInternal\": \"Internal only\",\n    \"pPublic\": \"Public\",\n    \"stNone\": \"Not stored\",\n    \"stId\": \"Identifier only\",\n    \"stFull\": \"Stored\",\n    \"mNone\": \"Never\",\n    \"mRedacted\": \"Redacted only\",\n    \"mSample\": \"Samples only\",\n    \"mFull\": \"Permitted\",\n    \"rUnknown\": \"Unknown\",\n    \"rAsserted\": \"Asserted, not evidenced\",\n    \"rEvidenced\": \"Evidenced\",\n    \"rProhibited\": \"Prohibited\",\n    \"notRecorded\": \"Not recorded\",\n    \"statusTitle\": \"What the rights status column means\",\n    \"statusBody\": \"Evidenced means we hold the licence or the terms that permit the use. Asserted but not evidenced means a permission is claimed somewhere and we have not put the document behind it, and the register caps that source at internal use until we do. Unknown and prohibited both cap it at nothing. The status is a ceiling, so a column can never grant more than the status allows.\",\n    \"modelTitle\": \"Republication rights are not model-input rights\",\n    \"modelBody\": \"A source we may lawfully republish is not thereby a source we may send to an external model. Those are separate permissions and the register keeps them in separate columns. Today every row records model input as never, and no external model is called at all, because the enterprise agreement that would govern such a call is not in force.\",\n    \"neverTitle\": \"What we never take\",\n    \"neverBody\": \"The Ministry of Justice transaction portal and the Najiz interfaces are interactive portals built for people, not data products. We do not scrape them and we will not. A platform whose whole argument is verification cannot be caught taking that shortcut.\",\n    \"gapTitle\": \"The gap we have not closed\",\n    \"gapBody\": \"The Rent Index republishes benchmarks derived from the REGA Rental Index (Ejar), and the permitted use of that source is not established. We record it as ten separate clauses rather than one question, because a statement that permits public display and says nothing about retrieval does not permit retrieval nine tenths of the way. Each clause is answered only by recording the words of a written statement, never by a tick. Until every clause carries such an answer, no figure from that source is published anywhere: not on a page, not in an export, not in a machine readable response, and not by the assistant. This is carried as an open owner decision rather than resolved in our own favour.\",\n    \"o10CountLabel\": \"permitted-use clauses recorded for the REGA Rental Index (Ejar)\",\n    \"notShownTitle\": \"What this page does not show\",\n    \"notShownBody\": \"Three things are held back deliberately. The internal reasoning behind a refusal quotes licence terms we are not free to republish. The stop condition and the review note are recorded in one language only, so publishing them would put English text on the Arabic page and break the parity rule. And no licensor is named on a prohibited row, because naming them would republish the term we are respecting.\",\n    \"regNotConfiguredT\": \"The register is not connected in this deployment\",\n    \"regNotConfiguredB\": \"This build carries no database credentials, so no read of the register was attempted at all. Nothing is inferred from that silence. Every source is treated as permitting nothing until its own row has been read.\",\n    \"regReadFailedT\": \"The register could not be read\",\n    \"regReadFailedB\": \"The read was attempted and it failed. That is a fault on our side and not a statement about any licence. Until it succeeds, every source is treated as permitting nothing.\",\n    \"regNoRowsT\": \"The register returned no rows to this page\",\n    \"regNoRowsB\": \"The read succeeded and came back with nothing in it. Either the register holds no rows, or this page is not permitted to read the rows it holds, and the response cannot tell those two apart. We do not guess between them. Either way, every source is treated as permitting nothing.\",\n    \"sGastatT\": \"GASTAT and central bank published statistics\",\n    \"sGastatB\": \"Official published statistics. The published terms permit republication, including commercial republication, with attribution. That is a republication right and not a model-input right, which is exactly why the two are separate columns.\",\n    \"sRegaT\": \"REGA Rental Index (Ejar)\",\n    \"sRegaB\": \"Averages of registered lease contracts, republished with attribution. SAT does not originate these figures. The derivation, export and retrieval permissions are the open gap described above.\",\n    \"sBrokerT\": \"Third-party brokerage research\",\n    \"sBrokerB\": \"Published research from commercial firms. Each publisher forbids reproduction without written permission, so the register records this source as prohibited across every use and nothing on the platform draws on it.\",\n    \"sFsqT\": \"Open places data\",\n    \"sFsqB\": \"Open place records used for context around a building. Redisplay and derived display are permitted publicly under the open terms; export is held to internal use.\",\n    \"sMapboxT\": \"Map tiles and geocoding\",\n    \"sMapboxB\": \"Supplied under a service agreement that permits display through the service and nothing beyond it. No storage, no export, no retrieval.\",\n    \"sPermitT\": \"Advertising permits\",\n    \"sPermitB\": \"The permit lookup establishes whether a listing may lawfully be advertised. The outcome is a fact about the listing and is ours to state. The permit record itself is not republished.\",\n    \"sNafathT\": \"Nafath identity checks\",\n    \"sNafathB\": \"The assistant may say that an identity was checked. It may never retrieve the identity. Nothing from this source is kept beyond the outcome.\",\n    \"sWathqT\": \"Deed data\",\n    \"sWathqB\": \"The check outcome is a SAT fact about a listing. The deed payload belongs to the source, is not stored and is not shown.\",\n    \"sSplT\": \"National address data\",\n    \"sSplB\": \"Address normalisation. The permission is asserted from published terms, but the agreement is not on file, so the register holds this row at nothing until it is.\",\n    \"metaTitle\": \"Sources and data rights | SAT Markets\",\n    \"metaDesc\": \"The recorded policy for every data source: storage, redisplay, derived display, export, assistant retrieval and model input, with the rights status that caps each one.\"\n  },\n  \"bilingual\": {\n    \"eyebrow\": \"Trust and legal\",\n    \"title\": \"How this platform speaks in two languages\",\n    \"intro\": \"Arabic here is not a translation layer over an English product. Both languages are written against the same rules, and several of those rules exist because breaking one of them once cost us something. This page publishes the rules and the term base they are applied to.\",\n    \"parityT\": \"Parity is enforced, not intended\",\n    \"parityB\": \"The two dictionaries must carry exactly the same keys, and a test fails the build if they diverge. That test exists because a page once shipped with a hand-written object holding both languages side by side, and the English and Arabic branches quietly drifted into two different sets of commitments. Nobody noticed, because nobody reads both columns at once. Every string on a public page now comes from the dictionaries, and a scanner fails the build on any string that does not.\",\n    \"numeralsT\": \"Western numerals in both languages\",\n    \"numeralsB\": \"Arabic-Indic numerals are rejected by the Arabic linter across the whole Arabic surface. A figure a reader may need to check, copy or quote should not change shape depending on which language they opened.\",\n    \"rtlT\": \"True right to left\",\n    \"rtlB\": \"The Arabic document is served with its own direction rather than mirrored by a style rule, so the browser lays out text, punctuation and embedded numerals the way Arabic actually reads.\",\n    \"ownersT\": \"The spelling that separates owners from angels\",\n    \"ownersB\": \"The Arabic word for property owners and a quite different word meaning angels are written with the same letters and differ by one diacritic. We always write the diacritic. A test sweeps the whole source tree for the undiacriticised spelling and fails on every occurrence, which is why the rule holds rather than merely being agreed.\",\n    \"countT\": \"Counted nouns are computed, not guessed\",\n    \"countB\": \"Arabic counts in six forms rather than two, and the boundaries fall at one, two, three, eleven and one hundred. A sentence written for one count is wrong at another, so no sentence on this platform embeds its own count. The table below is produced live by the shared formatter at each boundary, in both languages.\",\n    \"countCaption\": \"Rendered at request time by the formatter every counted sentence uses.\",\n    \"avgT\": \"Average and median stay distinct\",\n    \"avgB\": \"They are different statistics and are never substituted for one another in either language. Where a figure is an average it is labelled an average, and the Arabic word follows the same rule rather than reaching for whichever term reads better.\",\n    \"distT\": \"A development is not a district\",\n    \"distB\": \"A planned project and an administrative district are different kinds of place, and merging them would let a project inherit a district's context and a district's figures. Both languages label them separately, everywhere.\",\n    \"indexT\": \"The index carries its source on every line\",\n    \"indexB\": \"Every reference to the Rent Index retains its attribution to the REGA Rental Index (Ejar), in both languages, and per line rather than once per page, because a line is what gets quoted.\",\n    \"voiceT\": \"Arabic written as Arabic\",\n    \"voiceB\": \"The linter rejects four habits that mark translated Arabic: the auxiliary construction that replaces a direct verb with a generic verb and a preposition, the analytic possessive where an attached pronoun is the natural form, calqued marketing idiom, and the em dash, which is not an Arabic punctuation mark and is banned in the English here as well.\",\n    \"termsT\": \"The term base\",\n    \"termsB\": \"The pairs below are the ones the platform actually uses, not a suggestion list. A term that renders one way on one surface and another way on the next is a defect, so the mapping lives in a single file and every surface reads it.\",\n    \"termsEn\": \"English\",\n    \"termsAr\": \"Arabic\",\n    \"termsCount\": \"Terms in the base\",\n    \"metaTitle\": \"Bilingual standards | SAT Markets\",\n    \"metaDesc\": \"Arabic is not a translation layer here. Enforced key parity, Western numerals, true right to left, counted nouns computed at every boundary, and the published term base.\"\n  }\n}\n</content>
