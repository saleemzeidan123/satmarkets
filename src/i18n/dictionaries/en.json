erts\",\n    \"rowRentIndex\": \"Rent Index\",\n    \"rowLocIntel\": \"Location Intelligence / mo\",\n    \"rowAdvisor\": \"AI Advisor queries / mo\",\n    \"rowExport\": \"Report export\",\n    \"rowSeats\": \"Team seats\",\n    \"rowApi\": \"API access\",\n    \"rowSupport\": \"Support\",\n    \"vAverages\": \"Averages\",\n    \"vFull\": \"Full\",\n    \"vFullHistory\": \"Full + history\",\n    \"vFullBulk\": \"Full + bulk\",\n    \"vFullFeed\": \"Full + feed\",\n    \"vCommunity\": \"Community\",\n    \"vEmail\": \"Email\",\n    \"vPriority\": \"Priority\",\n    \"vManager\": \"Manager\",\n    \"vSlaManager\": \"SLA + manager\",\n    \"vApiCalls\": \"25k/mo\",\n    \"vUnlimited\": \"∞\"\n  },\n  \"req\": {\n    \"openReqs\": \"Open requirements\",\n    \"h1\": \"Occupiers looking for space\",\n    \"sub\": \"The reverse of a listing. If you are an owner or broker with a match, register interest, the occupier sees who responded and chooses who to talk to.\",\n    \"postReq\": \"Post a requirement\",\n    \"loading\": \"Loading requirements…\",\n    \"lease\": \"Lease\",\n    \"buy\": \"Buy\",\n    \"noInterest\": \"No interest yet\",\n    \"viewRespond\": \"View & respond →\",\n    \"sampleTag\": \"Sample\",\n    \"metaTitle\": \"Requirements | SAT Markets\",\n    \"metaDesc\": \"Post what you need and let owners and licensed brokers come to you. The demand board for commercial space on SAT Markets.\",\n    \"empty\": \"No requirements are open right now. Post one and owners and licensed brokers see it here.\",\n    \"boardReady\": \"{n} open requirements loaded\",\n    \"boardReadyOne\": \"1 open requirement loaded\",\n    \"boardFailed\": \"The requirements board could not be loaded. This is a connection problem, not an empty market.\",\n    \"boardRetry\": \"Try again\",\n    \"timeline\": \"Move-in\"\n  },\n  \"about\": {\n    \"acronyms\": \"Nafath = national digital ID · REGA = Real Estate General Authority · Ejar = government tenancy registry · FAL = real-estate brokerage licence\",\n    \"metaTitle\": \"About | SAT Markets\",\n    \"metaDesc\": \"The neutral commercial real estate exchange for Saudi Arabia, powered by SAT Real Estate (REGA FAL 1200025510).\",\n    \"eyebrow\": \"About\",\n    \"title\": \"The neutral commercial real estate exchange for Saudi Arabia, built so every figure can name its source.\",\n    \"intro\": \"SAT Markets is an independent, neutral commercial real estate intelligence, leasing, and sales platform, starting in Riyadh. It brings together listings from owners and licensed brokers, a compliant viewing workflow, a rent index derived from the REGA Rental Index (Ejar), and a building-level intelligence map in one platform, delivered English-first with a full Arabic mirror. The platform is in preview on sample data, so the verification standard below describes how a listing will qualify at launch, not a check any preview record has already passed.\",\n    \"cardNeutralT\": \"Neutral by design\",\n    \"cardNeutralB\": \"Open to every owner and occupier. Platform-originated stock never silently outranks owner-direct listings.\",\n    \"cardCheckedT\": \"Checked, not classifieds\",\n    \"cardCheckedB\": \"This is a publishing standard, not a classifieds board. At launch an owner is checked, the right to lease is confirmed, and an advertising permit is recorded before a listing can carry a verified state. Preview inventory is sample data and holds no permit, so each listing shows only the state its own record supports.\",\n    \"cardMoatT\": \"A real data moat\",\n    \"cardMoatB\": \"A commercial rent index derived from the REGA Rental Index (Ejar): average rents by district and space type, minimum sample counts, and honest blanks where data is missing.\",\n    \"cardComplianceT\": \"Compliance-native\",\n    \"cardComplianceB\": \"Designed around REGA requirements, written mandates, ad-permit gating, and data-protection and e-invoicing by design.\",\n    \"verifyTitle\": \"Our verification standard\",\n    \"verifySub\": \"No anonymous classifieds. The standard has three gates: the person, the right to the property, and the licence. The automated lookups behind each gate arrive before launch, so nothing in this preview has been checked against Nafath, REGA or Ejar.\",\n    \"stepNafathT\": \"Nafath identity\",\n    \"stepNafathB\": \"SAT reviews the person behind each listing before it publishes. Nafath national-ID sign-in, binding identity to the national digital identity, arrives before launch.\",\n    \"stepOwnerT\": \"Ownership & permit\",\n    \"stepOwnerB\": \"Owners confirm ownership and the right to lease. Automated checks against REGA (the Real Estate General Authority) and the Ejar registry arrive before launch.\",\n    \"stepBrokerT\": \"Licensed brokers\",\n    \"stepBrokerB\": \"Brokers must hold a valid FAL licence from REGA. Automated verification against the REGA register arrives before launch.\",\n    \"stepLiveT\": \"Then it goes live\",\n    \"stepLiveB\": \"At launch a listing publishes only after all three gates pass, and its verified state names the gate it rests on rather than standing in for all three.\",\n    \"foot\": \"SAT Markets, commercial real estate intelligence for Saudi Arabia.\"\n  },\n  \"invest\": {\n    \"na\": \"n/a\",\n    \"assetTitle\": \"Grade A office floor · sample asset\",\n    \"csvSub\": \"Simulated underwriting on illustrative comparables. Indicative, not advice.\",\n    \"csvInputs\": \"Inputs\",\n    \"csvAcqPrice\": \"Acquisition price ({unit})\",\n    \"csvTerm\": \"Term (yr)\",\n    \"csvEscalation\": \"Escalation\",\n    \"csvOccupancy\": \"Occupancy\",\n    \"exitCapRate\": \"Exit cap rate\",\n    \"csvLtv\": \"LTV\",\n    \"csvOutputs\": \"Outputs\",\n    \"csvIndValue\": \"Indicative value ({unit})\",\n    \"netInitYield\": \"Net initial yield\",\n    \"csvNoi\": \"Stabilised NOI ({unit})\",\n    \"irr5\": \"5-yr levered IRR\",\n    \"equityMult\": \"Equity multiple\",\n    \"csvNoiByYear\": \"