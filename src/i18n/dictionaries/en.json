me\": \"Home\",\n    \"crumbLI\": \"Location Intelligence\",\n    \"eyebrow\": \"Location Intelligence · Q2 2026\",\n    \"h1\": \"Al Olaya trade area\",\n    \"intro\": \"Footfall, catchment and co-tenancy. Every figure on this page is sample data. No mobility, spend or demographic source is contracted, so nothing here is a market reading.\",\n    \"driveTime10\": \"Trade area · sample\",\n    \"weekday\": \"Weekday\",\n    \"export\": \"Export\",\n    \"askAi\": \"Ask AI\",\n    \"subject\": \"Subject\",\n    \"tradeArea\": \"Trade area\",\n    \"comparableOccupiers\": \"Comparable occupiers\",\n    \"driveTimeRange\": \"Sample trade-area outline, not a computed travel time\",\n    \"daytimePop\": \"Daytime population\",\n    \"vsDistrict\": \"+18% vs district avg\",\n    \"residentPop\": \"Resident population\",\n    \"within10\": \"within 10-min\",\n    \"footfallIndex\": \"Footfall index (city = 100)\",\n    \"qoq6\": \"+6 QoQ\",\n    \"dwell47\": \"47 min\",\n    \"medianDwell\": \"Median dwell time\",\n    \"min4yoy\": \"+4 min YoY\",\n    \"visitFreq\": \"Visit frequency / month\",\n    \"repeat58\": \"repeat visitors 58%\",\n    \"medianIncome\": \"Median income index\",\n    \"topQuartile\": \"top-quartile catchment\",\n    \"footfallRhythm\": \"Footfall rhythm, weekday\",\n    \"hourlyIndex\": \"Hourly index · peaks 12-14h & 18-19h\",\n    \"olaya\": \"Olaya\",\n    \"catchmentFrom\": \"Where the catchment comes from\",\n    \"catchmentFromSub\": \"Home-origin of daytime visitors\",\n    \"ageMix\": \"Catchment age mix\",\n    \"ageMixSub\": \"Daytime visitors · skews working-age professional\",\n    \"aged2544\": \"aged 25-44\",\n    \"coTenancy\": \"Co-tenancy mix in trade area\",\n    \"coTenancySub\": \"Occupiers listed within 10-min drive\",\n    \"coTenancyNote\": \"Occupier mix is drawn from SAT listing records. The mobility, dwell and spend figures are sample data and no source behind them is contracted. What a source has to satisfy before any of them becomes a real figure is set out below.\",\n    \"howTitle\": \"What a location source has to satisfy here\",\n    \"howH\": \"No global panel covers Saudi Arabia, and an uncontracted source publishes nothing\",\n    \"howBody\": \"Global footfall and site-selection platforms are built for United States and European markets, so a Saudi reading has to be sourced locally. SAT will publish a mobility figure only when the source permits aggregate publication in writing, the figure carries its panel basis, aggregation count and period, and user-level output is barred by contract. Until then the numbers above stay sample data.\",\n    \"scoreTitle\": \"Transparent score · five lenses\",\n    \"scoreBody\": \"Each site is scored across these five lenses with the reasoning shown, never a black-box number. Works across offices, retail, mixed-use and warehouses, not just retail.\",\n    \"pdplNote\": \"Location data is treated as sensitive: anonymised and aggregated. No on-site sensors and no personal images, ever.\",\n    \"signalsLabel\": \"Location signals\",\n    \"sampleTag\": \"Sample data\",\n    \"metaTitle\": \"Location Intelligence, Al Olaya trade area | SAT Markets\",\n    \"metaDesc\": \"Sample trade-area page for Al Olaya, Riyadh. Every figure is sample data and no mobility or spend source is contracted.\",\n    \"originHittin\": \"Hittin · Al Malqa\",\n    \"originKafd\": \"KAFD corridor\",\n    \"originDq\": \"Diplomatic Quarter\",\n    \"originWurud\": \"Al Wurud · Sulimaniyah\",\n    \"originOutside\": \"Outside Riyadh\",\n    \"mixCorporate\": \"Corporate office\",\n    \"mixBanking\": \"Banking & finance\",\n    \"mixFnb\": \"F&B\",\n    \"mixRetail\": \"Retail\",\n    \"mixMedical\": \"Medical\",\n    \"srcMobileT\": \"Mobile signals\",\n    \"srcMobileB\": \"Not contracted, and nothing on this page comes from one. A mobility source would have to permit aggregate publication, state its panel basis and known biases, and bar user-level output in writing.\",\n    \"srcMojT\": \"Ministry of Justice records\",\n    \"srcMojB\": \"The transaction portal is a service for people to read, not a data product, so SAT does not scrape it. Calibration against real deals waits on a lawful record-level feed.\",\n    \"srcSpendT\": \"Spend data\",\n    \"srcSpendB\": \"Not contracted, and no payment or transaction data reaches SAT. A spend source would need a written agreement, a cross-border basis and a disclosure position before it could inform anything.\",\n    \"srcPublicT\": \"Public records\",\n    \"srcPublicB\": \"GASTAT and SAMA for public context, and the REGA Rental Index (Ejar) for published rental averages with its required attribution. Averages, not medians.\",\n    \"scoreFoot\": \"Foot traffic\",\n    \"scoreDemo\": \"Demographics fit\",\n    \"scorePotential\": \"Market potential\",\n    \"scoreCompetition\": \"Competition\",\n    \"scoreVisibility\": \"Visibility\"\n  },\n  \"rentIndex\": {\n    \"na\": \"n/a\",\n    \"thinSample\": \"Thin sample\",\n    \"eyebrow\": \"Rent Index\",\n    \"h1\": \"Riyadh commercial rents\",\n    \"intro\": \"Averages of registered rental contracts, from the REGA Rental Index (Ejar). Districts without enough registered transactions are left blank.\",\n    \"all\": \"All\",\n    \"open\": \"Open\",\n    \"capped\": \"Capped\",\n    \"office\": \"Office\",\n    \"marketPulse\": \"Market pulse\",\n    \"export\": \"Export\",\n    \"askAi\": \"Ask AI\",\n    \"cappedExisting\": \"Existing leases · frozen at signature\",\n    \"cappedBody\": \"Renewals inside Riyadh’s urban boundary are held at their last Ejar rent for five years under the Sept-2025 decree.\",\n    \"cappedMovement\": \"movement on capped stock\",\n    \"openNew\": \"New & first-lease · sets the headline\",\n    \"openBody\": \"New-build and first-time leases are unaffected by the cap and continue to re-price to market each term.\",\n    \"yoyGradeA\": \"YoY on Grade A (published)\",\n    \"benchNote\": \"Every figure below is computed from a source file and traceable to it. Where a district did not clear the minimum transaction count, the cell is blank rather than estimated. Indicative, not advice.\",\n    \"tableTitle\": \"District figures\",\n    \"sortYoY\": \"Sort: YoY movement\",\n    \"thLocation\": \"Location\",\n    \"thAsset\": \"Asset\",\n    \"thStat\": \"Rent\",\n    \"thBand\": \"Band\",\n    \"thData\": \"Data\",\n    \"thSource\": \"Source\",\n    \"sufficient\": \"Sufficient\",\n    \"thin\": \"Thin\",\n    \"sample\": \"Sample\",\n    \"tableNote\": \"Pre-launch sample data illustrating the index mechanism. At launch, averages and bands are computed from verified closed transactions only, and thin samples are marked rather than shown. The index never prints a number it cannot stand behind.\",\n    \"trendT\": \"Rent trend over time\",\n    \"trendB\": \"We do not publish a rent trend yet. A trend needs several quarters of our own verified transactions to stand behind, and we have one quarter. Publishing a line before then would be drawing a shape, not reporting a market. It appears here when the history is real.\",\n    \"heatT\": \"Rent heat, by district\",\n    \"heatSubReal\": \"Darker is a higher figure\",\n    \"heatSubRealThin\": \"Districts with too thin a sample are left blank rather than guessed.\",\n    \"heatSubSample\": \"Preview sample figures. Darker is a higher average. Real district averages appear here at launch.\",\n    \"heatLow\": \"Lower\",\n    \"heatHigh\": \"Higher\",\n    \"metaTitle\": \"Rent Index | SAT Markets\",\n    \"metaDesc\": \"Saudi commercial rent figures by district and asset type, derived from the REGA Rental Index (Ejar). Averages of registered contracts, with honest blanks where the sample is too thin. Indicative, not advice.\",\n    \"kpiOffice\": \"Office rent, average across cells\",\n    \"kpiRetail\": \"Retail rent, average across cells\",\n    \"kpiContracts\": \"average of registered contracts\",\n    \"kpiCells\"