# SAT Markets - environment
# Supabase (the SAT Markets project, NOT SAT CRM)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
# Anthropic for the AI search/enrichment layer (search intent only, never rent figures)
ANTHROPIC_API_KEY=

# Verification review (internal). Set both to enable the /verify queue and the approve/reject action.
# ADMIN_REVIEW_TOKEN: any long random string; also the ?key= to open /verify.
# SUPABASE_SERVICE_ROLE_KEY: Supabase Project Settings, API, service_role. Server-side only, never client.
ADMIN_REVIEW_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
